# Datasets and generated outputs — fetched/produced by run.sh, not source
data/
output/

# ns-3/ndnSIM trace and log output (regenerated by every run) —
# targeted by file, not by directory, so a .gitkeep can still hold
# the logs/ directories in place for a fresh clone (gaia-sfl-tcp.cc
# and gaia-sfl-tcp-wifi.cc open their CSV log with a plain
# std::ofstream, which does not create missing parent directories)
*.log
scratch/gaia-sfl-ndn/*.txt
scratch/gaia-sfl-ndn/*.csv
scratch/gaia-sfl-tcp/*.csv
scratch/gaia-sfl-tcp-wifi/*.csv
scratch/gaia-sfl-ndn-wifi/*.txt
scratch/gaia-sfl-ndn-wifi/*.csv
scratch/gaia-sfl-ndn-wifi/*.xml

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Editor/OS cruft
.DS_Store
*.swp
