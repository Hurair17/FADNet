# Datasets and generated outputs — fetched/produced by run.sh, not source
data/
output/

# ns-3/ndnSIM trace and log output (regenerated by every run) — targeted
# by directory, not by extension, so real .txt content like readme.txt
# doesn't get swept up too
*.log
scratch/gaia-sfl-ndn/*.txt
scratch/gaia-sfl-ndn/*.csv
scratch/gaia-sfl-ndn/logs/
scratch/gaia-sfl-tcp/*.txt
scratch/gaia-sfl-tcp/*.csv
scratch/gaia-sfl-tcp/logs/
scratch/gaia-sfl-ndn-wifi/*.txt
scratch/gaia-sfl-ndn-wifi/*.csv
scratch/gaia-sfl-ndn-wifi/*.xml
scratch/gaia-sfl-ndn-wifi/logs/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Editor/OS cruft
.DS_Store
*.swp
